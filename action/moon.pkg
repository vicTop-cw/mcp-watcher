import {
  "mcp-watcher/config",
  "mcp-watcher/watch",
  "mcp-watcher/util",
  "vicTop-cw/RX-MBT/rx",
  "vicTop-cw/RX-MBT/rhop_task" @rt,
  "vicTop-cw/RX-MBT/monitor" @mon,
  "moonbitlang/async/fs" @fs,
  "moonbitlang/core/json",
  "moonbitlang/core/ref",
  "moonbitlang/core/debug",
  "moonbitlang/core/async",
  "moonbitlang/core/encoding/utf8" @utf8,
}

options(
  // native 门控说明：
  //   - p3_persist_native_test.mbt 走 @mon.fs_write_atomic / fs_read_text，
  //     依赖 native C FFI（js/wasm 无文件系统）。
  //   - acceptance_native_test.mbt 走真实 cmd 命令 + 真实目录枚举
  //     （fs_list_stub.c 为 native 专属 C FFI）。
  //   - guard_native_test.mbt 走真实 cmd 命令（守卫门 exit 语义）。
  targets: {
    "p3_persist_native_test.mbt": [ "native" ],
    "acceptance_native_test.mbt": [ "native" ],
    "guard_native_test.mbt": [ "native" ],
    "trash_native.mbt": [ "native" ],
    "trash_native_test.mbt": [ "native" ],
    "trash_stub.mbt": [ "js", "wasm" ],
    // EP-01b webhook：js 目标真实 HTTP e2e / native 目标诚实降级
    "webhook_js_test.mbt": [ "js" ],
    "webhook_native_test.mbt": [ "native" ],
  },
  "native-stub": [ "fs_list_stub.c" ],
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
