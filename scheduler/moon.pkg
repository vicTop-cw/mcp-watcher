import {
  "mcp-watcher/config",
  "mcp-watcher/watch",
  "mcp-watcher/rule",
  "mcp-watcher/action",
  "vicTop-cw/RX-MBT/rx",
  "vicTop-cw/RX-MBT/rhop_task" @rt,
  "vicTop-cw/RX-MBT/monitor" @mon,
  "moonbitlang/core/ref",
  "moonbitlang/core/debug",
  "moonbitlang/core/async",
}

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  // guard_native_test.mbt 走真实 Windows cmd 命令（守卫门 exit 语义 + 组合场景），
  // js/wasm 下命令行为不一致，门控为 native 专属（与 action 包同范式）。
  targets: {
    "guard_native_test.mbt": [ "native" ],
  },
)
