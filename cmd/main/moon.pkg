import {
  "vicTop-cw/mcp-watcher/config",
  "vicTop-cw/mcp-watcher/watch",
  "vicTop-cw/mcp-watcher/scheduler",
  "vicTop-cw/mcp-watcher/action",
  "vicTop-cw/mcp-watcher/util",
  "vicTop-cw/mcp-watcher/index",
  "vicTop-cw/RX-MBT/rx",
  "vicTop-cw/RX-MBT/monitor" @mon,
  "vicTop-cw/RX-MBT/rhop_task" @rt,
  "moonbitlang/core/ref",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "moonbitlang/core/debug",
}

pkgtype(kind: "executable")

// 依赖 index（native-only SQLite FFI）与 RX-MBT 原生监控，可执行文件仅
// native 目标可构建；js/wasm 目标由各库包测试覆盖，cmd 不参与。
supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
