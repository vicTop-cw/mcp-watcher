supported_targets = "native"

import {
  "moonbitlang/x/encoding" @encoding,
  "moonbitlang/core/bench",
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/core/debug",
}

options(
  "targets": {
    "sqlite_js.mbt": [ "js" ],
  },
  "native-stub": [ "stub.c" ],
  link: { "native": { "cc-link-flags": "sqlite/vendor/sqlite3.lib" } },
)
